<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f1ec;padding:32px 12px;font-family:Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background-color:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);">
        <tr>
          <td style="background-color:#1f2a24;padding:32px 32px 28px;text-align:center;">
            <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#c9a86a;">DineHub</div>
            <div style="font-size:26px;font-weight:bold;color:#ffffff;padding-top:10px;">Reset your password</div>
          </td>
        </tr>

        <tr>
          <td style="padding:32px 32px 8px;">
            <p style="margin:0;font-size:16px;color:#1f2a24;">Hi <%= @user.first_name %>,</p>
            <p style="margin:14px 0 0;font-size:15px;line-height:24px;color:#4a5450;">
              We received a request to reset the password for your DineHub account.
              Use the button below to choose a new password.
            </p>
          </td>
        </tr>

        <tr>
          <td align="center" style="padding:24px 32px;">
            <a href="<%= @reset_password_url %>" style="display:inline-block;background-color:#c9a86a;color:#1f2a24;text-decoration:none;font-weight:bold;padding:12px 24px;border-radius:6px;">
              Reset password
            </a>
          </td>
        </tr>

        <tr>
          <td style="padding:0 32px 32px;">
            <p style="margin:0;font-size:14px;line-height:23px;color:#6b7370;">
              If you did not request this, you can ignore this email. The link will expire after a short time.
            </p>
            <p style="margin:14px 0 0;font-size:12px;line-height:20px;color:#9a938a;word-break:break-all;">
              <%= @reset_password_url %>
            </p>
          </td>
        </tr>

        <tr>
          <td style="background-color:#1f2a24;padding:22px 32px;text-align:center;">
            <div style="font-size:14px;color:#ffffff;">See you at the table.</div>
            <div style="padding-top:6px;font-size:12px;color:#9aa5a0;">DineHub Restaurant</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
