<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#f4f1ec;padding:32px 12px;font-family:Helvetica,Arial,sans-serif;">
  <tr>
    <td align="center">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="width:100%;max-width:600px;background-color:#ffffff;border-radius:10px;overflow:hidden;box-shadow:0 1px 4px rgba(0,0,0,0.08);">
        <tr>
          <td style="background-color:#1f2a24;padding:32px 32px 28px;text-align:center;">
            <div style="font-size:13px;letter-spacing:3px;text-transform:uppercase;color:#c9a86a;">DineHub</div>
            <div style="font-size:26px;font-weight:bold;color:#ffffff;padding-top:10px;">Your table is booked</div>
          </td>
        </tr>

        <tr>
          <td style="padding:32px 32px 8px;">
            <p style="margin:0;font-size:16px;color:#1f2a24;">Hi <%= @reservation.full_name %>,</p>
            <p style="margin:14px 0 0;font-size:15px;line-height:24px;color:#4a5450;">
              Thank you for choosing us. Your reservation is confirmed and we have your table ready for the details below.
            </p>
          </td>
        </tr>

        <tr>
          <td style="padding:24px 32px 8px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background-color:#faf8f5;border:1px solid #ece7de;border-radius:8px;">
              <tr>
                <td style="padding:20px 24px 4px;font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#9a938a;">Reservation details</td>
              </tr>
              <tr>
                <td style="padding:8px 24px 20px;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-size:15px;color:#1f2a24;">
                    <tr>
                      <td style="padding:8px 0;color:#6b7370;width:40%;">Guest</td>
                      <td style="padding:8px 0;font-weight:bold;"><%= @reservation.full_name %></td>
                    </tr>
                    <tr>
                      <td style="padding:8px 0;color:#6b7370;border-top:1px solid #ece7de;">Location</td>
                      <td style="padding:8px 0;font-weight:bold;border-top:1px solid #ece7de;"><%= @reservation.location %></td>
                    </tr>
                    <tr>
                      <td style="padding:8px 0;color:#6b7370;border-top:1px solid #ece7de;">Date</td>
                      <td style="padding:8px 0;font-weight:bold;border-top:1px solid #ece7de;"><%= @reservation.reservation_date.to_date.strftime("%A, %B %-d, %Y") %></td>
                    </tr>
                    <tr>
                      <td style="padding:8px 0;color:#6b7370;border-top:1px solid #ece7de;">Arrival time</td>
                      <td style="padding:8px 0;font-weight:bold;border-top:1px solid #ece7de;"><%= @reservation.parsed_start_time.strftime("%-l:%M %p") %></td>
                    </tr>
                    <% if @reservation.occasion.present? %>
                      <tr>
                        <td style="padding:8px 0;color:#6b7370;border-top:1px solid #ece7de;">Occasion</td>
                        <td style="padding:8px 0;font-weight:bold;border-top:1px solid #ece7de;"><%= @reservation.occasion %></td>
                      </tr>
                    <% end %>
                    <% if @reservation.id.present? %>
                      <tr>
                        <td style="padding:8px 0;color:#6b7370;border-top:1px solid #ece7de;">Reference</td>
                        <td style="padding:8px 0;font-weight:bold;border-top:1px solid #ece7de;"><%= @reservation.id %></td>
                      </tr>
                    <% end %>
                  </table>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        <% if @reservation.special_requests.present? %>
          <tr>
            <td style="padding:16px 32px 0;">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-left:3px solid #c9a86a;background-color:#fdfbf7;border-radius:4px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <div style="font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#9a938a;">Special requests</div>
                    <div style="padding-top:8px;font-size:15px;line-height:23px;color:#1f2a24;"><%= @reservation.special_requests %></div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        <% end %>

        <tr>
          <td style="padding:24px 32px 32px;">
            <p style="margin:0;font-size:14px;line-height:23px;color:#6b7370;">
              Please arrive within 15 minutes of your booking time so we can hold your table.
              Need to change or cancel? Reply to this email or call us at <a href="tel:5550100" style="color:#1f2a24;">555-0100</a>.
            </p>
          </td>
        </tr>

        <tr>
          <td style="background-color:#1f2a24;padding:22px 32px;text-align:center;">
            <div style="font-size:14px;color:#ffffff;">We look forward to serving you.</div>
            <div style="padding-top:6px;font-size:12px;color:#9aa5a0;">DineHub Restaurant &middot; Reservations Team</div>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
